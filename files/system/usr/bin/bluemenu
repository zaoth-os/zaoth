#!/usr/bin/env bash
# This script is the front-end menu helper using WMENU.
# It handles different modes (apps, screenshot, powermenu, scratchpad)
# and forwards arguments directly to wmenu.

[[ -d "$HOME_MENUS" ]] && MENUS="$HOME_MENUS" || MENUS="$USR_MENUS" || MENUS="/usr/share/menus"
CACHE="$HOME/.cache/apps"

mode-scratchpad-windows () {
    swaymsg -t get_tree | jq -r '
        .. | select(.name? == "__i3_scratch") | recurse(.nodes[], .floating_nodes[]) | select(.type? == "floating_con") | "\(.id) - \(.name)"
    ' | sed '/^\s*$/d'
}

function noctalia_power_menu() {
    local opt="$(echo -e "󰐥 Shutdown\n󰜉 Reboot\n󰗽 Logout\n󰤄 Suspend\n󰌾 Lock" | noctalia dmenu -p "Power menu")"
    case "$opt" in
        *Shutdown)
            noctalia msg session shutdown
            ;;
        *Reboot)
            noctalia msg session reboot
            ;;
        *Logout)
            noctalia msg session logout
            ;;
        *Suspend)
            noctalia msg session suspend
            ;;
        *Lock)
            noctalia msg session lock
            ;;
    esac

}

function noctalia_screenshot_menu(){
    local opt="$(echo -e "󰊓 Screenshot-Fullscreen\n󰩬 Screenshot-Region" | noctalia dmenu -p "Select the mode")"
    case "$opt" in
        *-Fullscreen)
        noctalia msg screenshot-fullscreen
        ;;
        *-Region)
        noctalia msg screenshot-region
        ;;
    esac

}

function noctalia_scratchpad_menu() {
    choosen=$(mode-scratchpad-windows | noctalia dmenu -p "Restore from scratchpad")
    [[ -z "$choosen" ]] && return 0

    local win_id="${choosen%% *}"
    if [[ "$win_id" =~ ^[0-9]+$ ]]; then
        swaymsg "[con_id=$win_id] scratchpad show, floating toggle"
    fi
}

main () {
    local mode="$1"
    local choosen
    shift # Remove mode from arguments, leaving only wmenu_args

    case "$mode" in
        launcher)
            noctalia msg panel-open launcher
            ;;

        wallpaper)
            noctalia msg panel-open wallpaper
            ;;

        screenshot|power|scratchpad)
            "noctalia_${mode}_menu"
            ;;

    esac
}

main "$@"
