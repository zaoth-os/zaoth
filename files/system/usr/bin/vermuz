#!/usr/bin/env bash

set -euo pipefail

vermuz_version() {
    VERSION_FILE="version.sh"

    if [[ -f "$VERSION_FILE" ]]; then
        source "$VERSION_FILE"
    else
        V_STAGE="a"
        V_MAJOR="1"
        V_MINOR="0"
    fi


    if [[ $# -eq 2 ]]; then
        case "$1" in
            stage)V_STAGE="$2";;
            major) V_MAJOR="$2"; V_MINOR="0";;
            minor)V_MINOR="$2";;
        esac
    fi

    V_PATCH="$(date '+%Y%m%d%H%M')"
    FULL_VERSION="${V_STAGE}${V_MAJOR}.${V_MINOR}.${V_PATCH}"

    cat > "$VERSION_FILE" <<EOF
# Generated automatically

V_STAGE="${V_STAGE}"
V_MAJOR="${V_MAJOR}"
V_MINOR="${V_MINOR}"
V_PATCH="${V_PATCH}"

FULL_VERSION="${FULL_VERSION}"
EOF
    echo "Version: ${FULL_VERSION}"
}
vermuz_log() {
    local opt="$1"
    shift
    case "$opt" in
        --error) echo "ERROR: $@" >&2;;
        --warn) echo "WARNING: $@" >&2;;
        --info) echo "INFO: $@" >&2;;
    esac

}
vermuz_check() {
    local opt="$1"
    shift
    case "$opt" in
        --args-missing)
        if [[ -z "${from_src:-}" ]]; then
            vermuz_log --error "config missing -> 'from_src'"
            return 1
        fi

        if [[ -z "${to_src:-}" ]]; then
            vermuz_log --error "config missing -> 'to_src'"
            return 1
        fi
        return 0
        ;;
        --config-missing)
        if [[ ! -f "$download_src/setup" ]]; then
            vermuz_log --error "setup file not found -> '$download_src/setup'"
            return 1
        fi
        return 0
        ;;
    esac
}

vermuz_unique_tmp() {
    local tag="$(echo "$@ $(date '+%Y%m%d%H%M')" | md5sum | tr -d " -")"
    local working="/tmp/vermuz/$tag"
    vermuz_log --info "creating temp working tree..."
    if [[ -d "$working" ]]; then
        vermuz_log --warn "duplicate working tree -> $working"
        rm -rf "$working"
    fi
    echo "$working"
}

vermuz_install() {
    default_provider="github.com"
    repo_user="$1"
    repo_name="$2"
    repo_provider="${3:-$default_provider}"
    repo_url="https://$repo_provider/$repo_user/$repo_name"
    download_src="$(vermuz_unique_tmp $repo_url)"

    vermuz_log --info "cloning install files from -> $repo_url"
    if ! git clone "$repo_url" "$download_src"; then
        vermuz_log --error "unable to clone repository -> $repo_url"
        return 1
    fi

    vermuz_log --info "starting to setup at -> $download_src..."
    if [[ ! -d "$download_src" ]]; then
        vermuz_log --error "'$download_src' not found.."
        return 1
    fi
    setup_file="$download_src/setup"
    if [[ ! -f "$setup_file" ]]; then
        vermuz_log --error "setup file not found -> '$setup_file'"
        return 1
    fi

    vermuz_log --info "getting setup config from -> $setup_file"
    source "$download_src/setup"
    if ! vermuz_check --args-missing; then
        return 1
    fi

    vermuz_log --info "starting to copy files from $from_src to $to_src..."
    mkdir -p "$to_src"
    if ! cp -a "$from_src"/. "$to_src"/; then
        vermuz_log \
            --error \
            "unable to copy files from $from_src to $to_src"
        return 1
    else
        vermuz_log --info "success to copy files from $from_src to $to_src"
    fi
}

main () {
    local opt="$1"
    shift

    case $opt in
        --install) vermuz_install $@;;
        --version-build) vermuz_version $@;;
    esac
}

main "$@"
