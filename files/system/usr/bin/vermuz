#!/usr/bin/env bash

set -euo pipefail

vermuz_version() {
    VERSION_FILE="version.sh"

    if [[ -f "$VERSION_FILE" ]]; then
        source "$VERSION_FILE"
    else
        V_STAGE="a"
        V_MAJOR="1"
        V_MINOR="0"
    fi


    if [[ $# -eq 2 ]]; then
        case "$1" in
            stage)V_STAGE="$2";;
            major) V_MAJOR="$2"; V_MINOR="0";;
            minor)V_MINOR="$2";;
        esac
    fi

    V_PATCH="$(date '+%Y%m%d%H%M')"
    FULL_VERSION="${V_STAGE}${V_MAJOR}.${V_MINOR}.${V_PATCH}"

    cat > "$VERSION_FILE" <<EOF
# Generated automatically

V_STAGE="${V_STAGE}"
V_MAJOR="${V_MAJOR}"
V_MINOR="${V_MINOR}"
V_PATCH="${V_PATCH}"

FULL_VERSION="${FULL_VERSION}"
EOF
    echo "Version: ${FULL_VERSION}"
}

vermuz_install() {
    local default_provider="github.com"
    local repo_user="$1"
    local repo_name="$2"
    local repo_provider="${3:-$default_provider}"
    echo "Creating temp download tree..."
    local download_src="/tmp/vermuz/download/$repo_name"
    echo "Cloning repository"
    git clone https://$repo_provider/$repo_user/$repo_name $download_src
    echo "Start to setup"
    cd $download_src || echo "Repo tree not found.."
    source $download_src/setup
    mkdir -p $_TO
    cp -r $_FROM $_TO || echo "Error to copy files from $_FROM $_TO"
}

main () {
    local opt="$1"
    shift

    case $opt in
        --install) vermuz_install $@;;
        --version-build) vermuz_version $@;;
    esac
}

main "$@"
