#!/usr/bin/env bash

set -euo pipefail

vermuz_version() {
    VERSION_FILE="version.sh"

    if [[ -f "$VERSION_FILE" ]]; then
        source "$VERSION_FILE"
    else
        V_STAGE="a"
        V_MAJOR="1"
        V_MINOR="0"
    fi


    if [[ $# -eq 2 ]]; then
        case "$1" in
            stage)V_STAGE="$2";;
            major) V_MAJOR="$2"; V_MINOR="0";;
            minor)V_MINOR="$2";;
        esac
    fi

    V_PATCH="$(date '+%Y%m%d%H%M')"
    FULL_VERSION="${V_STAGE}${V_MAJOR}.${V_MINOR}.${V_PATCH}"

    cat > "$VERSION_FILE" <<EOF
# Generated automatically

V_STAGE="${V_STAGE}"
V_MAJOR="${V_MAJOR}"
V_MINOR="${V_MINOR}"
V_PATCH="${V_PATCH}"

FULL_VERSION="${FULL_VERSION}"
EOF
    echo "Version: ${FULL_VERSION}"
}
vermuz_log() {
    local opt="$1"
    shift
    case "$opt" in
        --error) echo "ERROR: $@" >&2;;
        --warn) echo "WARNING: $@" >&2;;
        --info) echo "INFO: $@" >&2;;
    esac

}
vermuz_check() {
    local opt="$1"
    shift
    case "$opt" in
        --args-missing)
        if [[ -z "${from_src:-}" ]]; then
            vermuz_log --error "config missing -> 'from_src'"
            return 1
        fi

        if [[ -z "${to_src:-}" ]]; then
            vermuz_log --error "config missing -> 'to_src'"
            return 1
        fi
        return 0
        ;;
        --config-missing)
        if [[ ! -f "$download_src/setup" ]]; then
            vermuz_log --error "setup file not found -> '$download_src/setup'"
            return 1
        fi
        return 0
        ;;
    esac
}

vermuz_install() {
    default_provider="github.com"
    repo_user="$1"
    repo_name="$2"
    repo_provider="${3:-$default_provider}"

    vermuz_log --info "Creating temp download tree..."
    download_src="/tmp/vermuz/download/$repo_name"

    vermuz_log --info "Cloning install files.."
    rm -rf "$download_src"
    git clone "https://$repo_provider/$repo_user/$repo_name" "$download_src"

    vermuz_log --info "Starting to setup..."
    if cd "$download_src"; then
        if vermuz_check --config; then
            source "$download_src/setup"
            if vermuz_check --params; then
                mkdir -p $to_src
                if ! cp -a "$from_src"/. "$to_src"/; then
                    vermuz_log --error "unable to copy files from $from_src to $to_src"
                    return 1
                fi
            else
                return 1
            fi
        else
            return 1
        fi
    else
        vermuz_log --error "$download_src not found.."
        return 1
    fi
}

main () {
    local opt="$1"
    shift

    case $opt in
        --install) vermuz_install $@;;
        --version-build) vermuz_version $@;;
    esac
}

main "$@"
